{
  "name": "nullvariant-vscode-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "VS Code extensions monorepo",
  "author": "Null;Variant <null@nullvariant.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "prepare": "husky || true",
    "lint:all": "pnpm -r --if-present run lint",
    "test:all": "pnpm -r --if-present run test",
    "compile:all": "pnpm -r --if-present run compile",
    "watch:all": "pnpm -r --if-present run watch"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  },
  "lint-staged": {
    "*.md": "prettier --write"
  }
}
